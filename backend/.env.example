# =============================================================================
# SmartInterview AI - Backend Environment Configuration (.env.example)
# Note: Do NOT commit real production credentials or keys to source control.
# =============================================================================

# --- Server Configuration ---
PORT=5000
NODE_ENV=development

# --- Database Connection ---
# Local: mongodb://localhost:27017/ai_interview_db
# Production (MongoDB Atlas): mongodb+srv://<username>:<password>@<cluster>.mongodb.net/smart_interview?retryWrites=true&w=majority
MONGO_URI=mongodb://localhost:27017/ai_interview_db

# --- Authentication & JWT ---
# Generate a strong 64-character random string for production
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=7d

# --- Client Application URLs (CORS & OAuth Redirects) ---
# Set to your production frontend URL (e.g., https://your-app.vercel.app)
CLIENT_URL=http://localhost:5173
FRONTEND_URL=http://localhost:5173

# --- AI Service (Groq / OpenAI API) ---
# Primary engine for question generation, evaluation, speech-to-text, and interview feedback
OPENAI_API_KEY=your_groq_or_openai_api_key_here
OPENAI_MODEL=openai/gpt-oss-120b
OPENAI_TIMEOUT_MS=30000
GROQ_TRANSCRIPTION_MODEL=whisper-large-v3-turbo

# --- Problem Solving Code Execution Sandbox (Judge0) ---
# Public sandbox default: https://ce.judge0.com
JUDGE0_URL=https://ce.judge0.com
EXECUTION_TIMEOUT_MS=12000

# --- Google OAuth 2.0 ---
# Obtain from Google Cloud Console (APIs & Services -> Credentials)
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback

# --- GitHub OAuth ---
# Obtain from GitHub Developer Settings -> OAuth Apps
GITHUB_CLIENT_ID=your_github_client_id_here
GITHUB_CLIENT_SECRET=your_github_client_secret_here
GITHUB_CALLBACK_URL=http://localhost:5000/api/auth/github/callback

# --- Email Service for Password Resets (Nodemailer / Gmail App Password) ---
EMAIL_USER=your_email@gmail.com
EMAIL_APP_PASSWORD=your_16_character_app_password
MAIL_FROM="SmartInterview AI" <no-reply@smartinterview.ai>

# Optional Custom SMTP settings (leave empty to use Gmail service)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# --- Optional AWS Bedrock (Alternative LLM Provider) ---
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
BEDROCK_MODEL_ID=anthropic.claude-3-haiku-20240307-v1:0
